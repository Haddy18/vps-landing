# Configuración de scripts/deploy.sh — plantilla.
# Copia a .env (gitignored) y rellena; en CI los mismos nombres son secrets.

# Host del VPS (IP o dominio).
VPS_HOST=

# Usuario ssh del VPS.
VPS_USER=

# Puerto ssh del VPS.
VPS_SSH_PORT=

# Ruta ABSOLUTA del VPS donde se deja la landing. El script la usa como base
# para el intercambio atómico (<ruta>.tmp → <ruta>) y solo acepta rutas
# profundas: rechaza "/", "/root", "/var", "/var/www" y "/var/www/html" para
# no poder borrar nada grueso por error. No terminar en barra.
VPS_DEPLOY_PATH=

# URL pública de la landing. Sirve para la verificación final (debe responder
# 200 y con content-type text/html). Para la raíz usa "/" o la URL completa.
SITE_URL=/

# --- Acceso -----------------------------------------------------------------
# En local: helper del escritorio con las credenciales del VPS (no se copian
# al repo). Con VPS_SSH vacío se usa ssh con clave (modo CI): entonces la
# clave la aporta VPS_SSH_KEY (o ~/.ssh/github-actions-deploy) y el host key
# está fijado en .github/known_hosts. Si VPS_SSH está definido, manda sobre
# VPS_HOST/USER/PUERTO. Ojo: el valor va ENTRE COMILLAS si contiene espacios.
VPS_SSH=

# Modo CI (GitHub Actions). No hace falta en local.
# Clave ssh privada cuya parte pública está en authorized_keys del VPS.
VPS_SSH_KEY=
